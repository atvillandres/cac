{
  "name": "cacentrp",
  "version": "0.1.0",
  "private": true,
  "description": "Modern TypeScript bootstrap for legacy PowerBuilder CAC Enterprise (cacentrp.exe)",
  "type": "module",
  "bin": {
    "cacentrp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
