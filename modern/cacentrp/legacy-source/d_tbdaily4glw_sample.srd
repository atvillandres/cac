release 7;
datawindow(units=0 timer_interval=0 color=15793151 processing=0 HTMLDW=no print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 100 print.margin.bottom = 200 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=524 color="536870912" )
summary(height=88 color="536870912" )
footer(height=0 color="536870912" )
detail(height=0 color="536870912" )
table(column=(type=char(3) updatewhereclause=yes name=focode dbname="FOCODE" )
 column=(type=date updatewhereclause=yes name=refdate dbname="REFDATE" )
 column=(type=date updatewhereclause=yes name=processdate dbname="PROCESSDATE" )
 column=(type=char(20) updatewhereclause=yes name=acctcode dbname="ACCTCODE" )
 column=(type=char(2) updatewhereclause=yes name=drcr dbname="DRCR" )
 column=(type=decimal(2) updatewhereclause=yes name=amount dbname="AMOUNT" )
 column=(type=char(4) updatewhereclause=yes name=cocode dbname="COCODE" )
 column=(type=char(4) updatewhereclause=yes name=recdest dbname="RECDEST" )
 retrieve="  SELECT ~"CURRLEDGE~".~"FOCODE~",   
         ~"CURRLEDGE~".~"REFDATE~",   
         ~"CURRLEDGE~".~"PROCESSDATE~",   
         ~"CURRLEDGE~".~"ACCTCODE~",   
         ~"CURRLEDGE~".~"DRCR~",   
         ~"CURRLEDGE~".~"AMOUNT~",   
         ~"CURRLEDGE~".~"COCODE~",   
         ~"CURRLEDGE~".~"RECDEST~"  
    FROM ~"CURRLEDGE~"  
   WHERE  ~"CURRLEDGE~".~"PROCESSDATE~" between :ldt_fromdate AND :ldt_todate    
" arguments=(("ldt_fromdate", date),("ldt_todate", date))  sort="focode A refdate A recdest D acctcode A " )
group(level=1 header.height=0 trailer.height=0 by=("focode" ) header.color="536870912" trailer.color="536870912" )
group(level=2 header.height=0 trailer.height=0 by=("focode" , "refdate" ) header.color="536870912" trailer.color="536870912" )
group(level=3 header.height=0 trailer.height=0 by=("focode" , "refdate" , "recdest" ) header.color="536870912" trailer.color="536870912" )
group(level=4 header.height=0 trailer.height=0 by=("focode" , "refdate" , "recdest" , "acctcode" ) header.color="536870912" trailer.color="536870912" )
text(band=header alignment="0" text="Centralized Accounting Channel System" border="0" color="0" x="69" y="48" height="64" width="1714"  name=t_7  font.face="Courier New" font.height="-10" font.weight="700"  font.family="1" font.pitch="1" font.charset="0" font.italic="1" background.mode="1" background.color="553648127" )
