compute(band=summary alignment="1" expression="sum(  debit_compute  for all )"border="0" color="0" x="1664" y="8" height="48" width="590" format="#,##0.00"  name=grandtotal_debit  font.face="Courier New" font.height="-8" font.weight="400"  font.family="1" font.pitch="1" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=summary alignment="1" expression="sum(   credit_compute  for all )"border="0" color="0" x="2277" y="8" height="48" width="590" format="#,##0.00"  name=grandtotal_credit  font.face="Courier New" font.height="-8" font.weight="400"  font.family="1" font.pitch="1" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=summary alignment="1" expression="round( grandtotal_debit, 2 )  -   round( grandtotal_credit, 2 )"border="0" color="0" x="2889" y="8" height="48" width="590" format="#,##0.00;(#,##0.00)"  name=compute_4  font.face="Courier New" font.height="-8" font.weight="400"  font.family="1" font.pitch="1" font.charset="0" background.mode="1" background.color="536870912" )
