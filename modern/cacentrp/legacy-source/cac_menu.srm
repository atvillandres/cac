type m_administration from menu within cac_menu
m_referencefilemaint m_referencefilemaint
m_usermaintenance m_usermaintenance
m_audittrail m_audittrail
m_resubmitfile m_resubmitfile
m_3 m_3
m_dailycdrfileconversion m_dailycdrfileconversion
m_oldbrsfileconversion m_oldbrsfileconversion
m_fcsrefreshreffiles m_fcsrefreshreffiles
end type

on m_administration.create
call super::create
this.text = "&Tools"
this.m_referencefilemaint=create m_referencefilemaint
this.m_usermaintenance=create m_usermaintenance
this.m_audittrail=create m_audittrail
this.m_resubmitfile=create m_resubmitfile
this.m_3=create m_3
this.m_dailycdrfileconversion=create m_dailycdrfileconversion
this.m_oldbrsfileconversion=create m_oldbrsfileconversion
this.m_fcsrefreshreffiles=create m_fcsrefreshreffiles
this.Item[UpperBound(this.Item)+1]=this.m_referencefilemaint
this.Item[UpperBound(this.Item)+1]=this.m_usermaintenance
this.Item[UpperBound(this.Item)+1]=this.m_audittrail
this.Item[UpperBound(this.Item)+1]=this.m_resubmitfile
this.Item[UpperBound(this.Item)+1]=this.m_3
this.Item[UpperBound(this.Item)+1]=this.m_dailycdrfileconversion
this.Item[UpperBound(this.Item)+1]=this.m_oldbrsfileconversion
this.Item[UpperBound(this.Item)+1]=this.m_fcsrefreshreffiles
end on

on m_administration.destroy
call super::destroy
destroy(this.m_referencefilemaint)
destroy(this.m_usermaintenance)
destroy(this.m_audittrail)
destroy(this.m_resubmitfile)
destroy(this.m_3)
destroy(this.m_dailycdrfileconversion)
destroy(this.m_oldbrsfileconversion)
destroy(this.m_fcsrefreshreffiles)
end on

