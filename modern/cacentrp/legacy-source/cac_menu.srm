global type cac_menu from menu
m_dailyprocessing m_dailyprocessing
m_reports m_reports
m_administration m_administration
m_window m_window
m_help m_help
m_exit m_exit
end type
global cac_menu cac_menu

on cac_menu.create
cac_menu=this
call super::create
this.m_dailyprocessing=create m_dailyprocessing
this.m_reports=create m_reports
this.m_administration=create m_administration
this.m_window=create m_window
this.m_help=create m_help
this.m_exit=create m_exit
this.Item[UpperBound(this.Item)+1]=this.m_dailyprocessing
this.Item[UpperBound(this.Item)+1]=this.m_reports
this.Item[UpperBound(this.Item)+1]=this.m_administration
this.Item[UpperBound(this.Item)+1]=this.m_window
this.Item[UpperBound(this.Item)+1]=this.m_help
this.Item[UpperBound(this.Item)+1]=this.m_exit
end on

on cac_menu.destroy
call super::destroy
destroy(this.m_dailyprocessing)
destroy(this.m_reports)
destroy(this.m_administration)
destroy(this.m_window)
destroy(this.m_help)
destroy(this.m_exit)
end on

event clicked;close(w_cac_frame)
end event

type m_dailyprocessing from menu within cac_menu
m_rundaily m_rundaily
m_createlspupload m_createlspupload
m_createglwfile m_createglwfile
m_endofdayprocessing m_endofdayprocessing
end type

on m_dailyprocessing.create
call super::create
this.text = "&Daily Processing"
this.mergeoption = windowmenu!
this.m_rundaily=create m_rundaily
this.m_createlspupload=create m_createlspupload
this.m_createglwfile=create m_createglwfile
this.m_endofdayprocessing=create m_endofdayprocessing
this.Item[UpperBound(this.Item)+1]=this.m_rundaily
this.Item[UpperBound(this.Item)+1]=this.m_createlspupload
this.Item[UpperBound(this.Item)+1]=this.m_createglwfile
this.Item[UpperBound(this.Item)+1]=this.m_endofdayprocessing
end on

on m_dailyprocessing.destroy
call super::destroy
destroy(this.m_rundaily)
destroy(this.m_createlspupload)
destroy(this.m_createglwfile)
destroy(this.m_endofdayprocessing)
end on

event clicked;IF NOT f_getcurrbkrate() THEN
	RETURN
END IF

//gdec_bkrate = 53.75
end event

