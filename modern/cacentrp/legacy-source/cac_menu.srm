on m_rundaily.create
call super::create
this.text = "Run Daily Process"
this.m_miscfilesprocess=create m_miscfilesprocess
this.m_autoemaildetach=create m_autoemaildetach
this.m_manualloading=create m_manualloading
this.m_brsupload=create m_brsupload
this.Item[UpperBound(this.Item)+1]=this.m_miscfilesprocess
this.Item[UpperBound(this.Item)+1]=this.m_autoemaildetach
this.Item[UpperBound(this.Item)+1]=this.m_manualloading
this.Item[UpperBound(this.Item)+1]=this.m_brsupload
end on

on m_rundaily.destroy
call super::destroy
destroy(this.m_miscfilesprocess)
destroy(this.m_autoemaildetach)
destroy(this.m_manualloading)
destroy(this.m_brsupload)
end on

